# Run python3 scripts/init-env.py to generate .env and random local secrets.
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434
FRONTEND_ORIGIN=http://localhost:5173
OIDC_ISSUER=http://localhost:8081/realms/aria
KEYCLOAK_HOSTNAME=http://localhost:8081
SERVICE_SECRET=generate-me
POSTGRES_PASSWORD=generate-me
KEYCLOAK_DB_PASSWORD=generate-me
MYSQL_ROOT_PASSWORD=generate-me
KEYCLOAK_ADMIN_PASSWORD=generate-me
ERPNEXT_PASSWORD=generate-me
ERPNEXT_USER_PASSWORD=generate-me
ERPNEXT_IMAGE=frappe/erpnext:v15
API_DOMAIN=api.example.com
AUTH_DOMAIN=auth.example.com
JOB_TIMEOUT_SECONDS=900
MAX_TOOL_CALLS=12
